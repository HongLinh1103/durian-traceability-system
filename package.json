{
    "name": "triviet-durian-farming-management",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "vercel-build": "prisma generate && (prisma migrate deploy || true) && next build",
        "postinstall": "prisma generate",
        "start": "next start",
        "lint": "next lint",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "typecheck": "tsc --noEmit",
        "db:start": "docker compose up -d postgres",
        "db:stop": "docker compose stop postgres",
        "seed": "npx tsx prisma/seed.ts",
        "migrate:legacy-news": "node scripts/import-legacy-news.cjs",
        "seed:materials": "node scripts/seed-material-catalog.cjs",
        "seed:prohibited-chemicals": "node scripts/seed-prohibited-chemicals.cjs",
        "import:prohibited-chemicals": "node scripts/import-prohibited-chemicals-from-excel.cjs",
        "seed:store-marketplace": "node scripts/seed-store-marketplace.cjs",
        "seed:store-demo": "npx tsx prisma/seed-store-demo.ts",
        "seed:store-finance": "npx tsx scripts/seed-store-finance-data.ts",
        "seed:regional-farms": "node scripts/seed-regional-farms-and-logs.cjs",
        "seed:role-accounts": "node scripts/seed-role-accounts.cjs",
        "seed:system-demo": "node scripts/seed-system-demo.cjs",
        "seed:farming-history": "node scripts/seed-farming-history.cjs",
        "seed:traceability": "tsx scripts/seed-traceability-demo.ts",
        "seed:partner-finance": "npx tsx scripts/seed-partner-finance-data.ts",
        "test:traceability": "tsx scripts/test-traceability.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.10.0",
        "@prisma/client": "^5.22.0",
        "@types/qrcode": "^1.5.6",
        "@zxing/browser": "^0.1.5",
        "@zxing/library": "^0.21.3",
        "bcryptjs": "^3.0.3",
        "browser-image-compression": "^2.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "idb": "^8.0.3",
        "lucide-react": "^0.446.0",
        "next": "14.2.17",
        "next-auth": "^4.24.11",
        "qrcode": "^1.5.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hook-form": "^7.53.2",
        "recharts": "^2.13.0",
        "sanitize-html": "^2.17.6",
        "tailwind-merge": "^2.5.4",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.7.6",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/sanitize-html": "^2.16.1",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.1",
        "eslint-config-next": "14.2.17",
        "postcss": "^8.4.47",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.4.14",
        "tsx": "^4.23.1",
        "typescript": "^5.6.3"
    }
}
