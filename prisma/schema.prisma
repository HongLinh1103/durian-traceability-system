generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hệ thống vai trò người dùng.
enum UserRole {
  ADMIN
  AREA_MANAGER
  FARMER
  STORE_OWNER
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerStatus {
  DRAFT
  PENDING
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerDocumentType {
  BUSINESS_REGISTRATION
  FOOD_SAFETY_CERTIFICATE
  PROCESSING_CERTIFICATE
  STANDARD_CERTIFICATE
  OTHER
}

enum HarvestBuyerType {
  UNDETERMINED
  COLLECTOR
  PROCESSING_FACILITY
  SELF_CONSUMPTION
}

enum HarvestStatus {
  DRAFT
  WAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  HARVESTING
  HARVESTED
  DELIVERY_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HarvestDeliveryMethod {
  BUYER_PICKUP
  FARMER_DELIVERY
  OTHER
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreDocumentType {
  BUSINESS_REGISTRATION
  PESTICIDE_TRADING_LICENSE
  SPECIALIZED_DOCUMENT
}

enum StoreProductType {
  FERTILIZER
  PESTICIDE
  EQUIPMENT
}

enum StoreProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN
  OUT_OF_STOCK
}

enum InventoryMovementType {
  IMPORT
  EXPORT
  ORDER_SALE
  ORDER_RETURN
}

enum InventoryDocumentType {
  PN
  PX
  DC
  HT
}

enum InventoryBusinessType {
  SUPPLIER_IMPORT
  STOCK_REPLENISHMENT
  RETURNED_GOODS_IMPORT
  SALE_EXPORT
  DISPOSAL_EXPORT
  TRANSFER_EXPORT
  STOCKTAKE_INCREASE
  STOCKTAKE_DECREASE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OPENING_BALANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StoreExpenseCategory {
  IMPORT_GOODS
  SHIPPING
  LABOR
  WAREHOUSE
  UTILITIES
  PACKAGING
  DELIVERY
  MARKETING
  MAINTENANCE
  OTHER
}

enum PartnerExpenseCategory {
  RAW_MATERIAL
  PROCESSING_LABOR
  PACKAGING
  COLD_STORAGE_ELECTRICITY
  LOGISTICS_TRANSPORT
  EQUIPMENT_MAINTENANCE
  FACTORY_OVERHEAD
  OTHER
}

/// Trạng thái duyệt tài khoản sau onboarding.
enum AccountStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
}

/// Giai đoạn sinh trưởng của cây sầu riêng.
enum GrowthStage {
  POST_HARVEST_RECOVERY
  MAKING_SPROUT
  FLOWER_INDUCTION
  FLOWERING
  FRUIT_SETTING
  FRUIT_GROWING
  PRE_HARVEST
  HARVEST
}

/// Loại hoạt động trong nhật ký canh tác.
enum ActivityType {
  BASE_FERTILIZING
  PLANTING
  MULCHING
  SPRAY_PESTICIDE
  FERTILIZE
  FOLIAR_FERTILIZING
  IRRIGATE
  PRUNE
  WEEDING
  SHOOT_MANAGEMENT
  WATER_STRESS
  FLOWER_INDUCTION
  FLOWER_THINNING
  POLLINATION
  FRUIT_THINNING
  PEST_INSPECTION
  TRACK_FRUIT
  FRUIT_BAGGING
  BRANCH_SUPPORT
  HARVEST
  FRUIT_GRADING
  GARDEN_SANITATION
  OTHER
}

enum PlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum CropSeasonStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProductBatchStatus {
  ACTIVE
  EXPIRED
  RECALLED
  QUARANTINED
  DEPLETED
}

enum SupplySourceType {
  STORE_PURCHASE
  SELF_DECLARED
  MANUAL_IMPORT
  OTHER
}

enum TraceComplianceStatus {
  PASS
  WARNING
  BLOCKED
}

enum HarvestLotStatus {
  DRAFT
  FINALIZED
  DISPATCHED
  PARTIALLY_USED
  USED
  CANCELLED
}

enum ProcurementOrderStatus {
  DRAFT
  CONFIRMED
  IN_DELIVERY
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  RECEIVED
  QC_PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QualityResult {
  PASSED
  FAILED
  CONDITIONAL
}

enum CollectionLotStatus {
  OPEN
  FINALIZED
  DISPATCHED
  PARTIALLY_USED
  USED
  CANCELLED
}

enum RawMaterialSourceType {
  HARVEST_LOT
  COLLECTION_LOT
}

enum RawMaterialReceiptStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  QC_PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RawMaterialLotStatus {
  PENDING_QC
  AVAILABLE
  QUARANTINED
  REJECTED
  PARTIALLY_USED
  USED
}

enum ProcessingBatchStatus {
  DRAFT
  PREPARING
  IN_PROGRESS
  PAUSED
  WAITING_FINISHED_QC
  COMPLETED
  CANCELLED
}

enum ProcessingStepType {
  RAW_MATERIAL_ISSUE
  CLEANING
  PEELING_PULP_SEPARATION
  REJECT_REMOVAL
  FINAL_WEIGHING
  PACKAGING
  FREEZING
  FINISHED_PRODUCT_QC
  FINISHED_PRODUCT_WAREHOUSE_IN
}

enum ProcessingStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum FinishedProductLotStatus {
  DRAFT
  PENDING_QC
  WAITING_WAREHOUSE_IN
  QC_HOLD
  QC_FAILED
  AVAILABLE
  READY_FOR_DISTRIBUTION
  PARTIALLY_DISTRIBUTED
  DISTRIBUTED
  RECALLED
}

enum LotEntityType {
  HARVEST_LOT
  COLLECTION_LOT
  RAW_MATERIAL_LOT
  PROCESSING_BATCH
  FINISHED_PRODUCT_LOT
  COMMERCIAL_LOT
}

enum LotRelationType {
  MERGED_INTO
  SPLIT_INTO
  SOLD_DIRECTLY_AS
  PROCESSED_INTO
  PACKAGED_INTO
  TRANSFERRED_INTO
}

enum DistributionDestinationType {
  RETAIL
  MARKET
  DISTRIBUTOR
  EXPORT
  OTHER
}

enum CommercialLotOwnerType {
  FARMER
  COLLECTOR
  PROCESSING_FACILITY
}

enum CommercialLotSourceType {
  HARVEST_LOT
  COLLECTION_LOT
  FINISHED_PRODUCT_LOT
}

enum CommercialLotStatus {
  DRAFT
  READY
  QR_ISSUED
  DISPATCHED
  RECEIVED
  CLOSED
  CANCELLED
  RECALLED
}

enum ShipmentSenderType {
  FARMER
  COLLECTOR
  PROCESSING_FACILITY
}

enum ShipmentStatus {
  DRAFT
  READY
  DISPATCHED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum TraceabilityCodeStatus {
  DRAFT
  READY_TO_ISSUE
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum GrowingRegionStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum GardenStatus {
  PENDING
  ACTIVE
  NEEDS_INSPECTION
  SUSPENDED
  INACTIVE
}

/// Trạng thái tuân thủ GACC cho thuốc bảo vệ thực vật.
enum GaccChemicalStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
  UNKNOWN
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// Danh mục Giống sầu riêng (Master Data)
model DurianVariety {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String    @unique
  alternativeName    String?
  scientificName     String?
  description        String?
  origin             String?
  averageHarvestDays Int?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("durian_varieties")
}

model CultivationStageCatalog {
  id         String                       @id @default(cuid())
  code       String                       @unique
  name       String
  sortOrder  Int                          @default(0)
  isActive   Boolean                      @default(true)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  activities CultivationActivityCatalog[]

  @@index([isActive, sortOrder])
  @@map("cultivation_stage_catalogs")
}

model CultivationActivityCatalog {
  id        String                  @id @default(cuid())
  stageId   String
  code      String
  name      String
  sortOrder Int                     @default(0)
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  stage     CultivationStageCatalog @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, code])
  @@index([stageId, isActive, sortOrder])
  @@map("cultivation_activity_catalogs")
}

/// Danh mục Thuốc bảo vệ thực vật (Master Data)
model Pesticide {
  id                  String             @id @default(cuid())
  code                String             @unique
  pesticideName       String?
  tradeName           String
  activeIngredient    String
  concentration       String?
  category            String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]           @default([])
  registrationNumber  String?
  gaccStatus          GaccChemicalStatus @default(UNKNOWN)
  localStatus         String?
  usagePurpose        String?
  targetPests         String?
  usageInstructions   String?
  recommendedDosage   String?
  safetyWarnings      String?
  storageInstructions String?
  phiDays             Int?
  notes               String?
  sourceReference     String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@map("pesticides")
}

/// Danh mục Phân bón (Master Data)
model Fertilizer {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  fertilizerType      String?
  brand               String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]  @default([])
  nutrientComposition String?
  mainUses            String?
  targetCrops         String?
  usageInstructions   String?
  recommendedDosage   String?
  applicationMethod   String?
  safetyWarnings      String?
  storageInstructions String?
  sourceReference     String?
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@map("fertilizers")
}

model User {
  id                      String        @id @default(cuid())
  phone                   String        @unique
  email                   String?       @unique
  password                String
  fullName                String?
  avatar                  String?
  birthDate               DateTime?
  gender                  String?
  address                 String?
  province                String?
  district                String?
  ward                    String?
  registrationName        String?
  registeredAreaSize      Float?
  registeredTotalTrees    Int?
  registeredDurianVariety String?
  role                    UserRole
  isApproved              Boolean       @default(false)
  failedAttempts          Int           @default(0)
  lockUntil               DateTime?
  isLocked                Boolean       @default(false)
  accountStatus           AccountStatus @default(PENDING)
  approvedAt              DateTime?
  lastLoginAt             DateTime?
  passwordUpdatedAt       DateTime?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  farms                    Farm[]
  notifications            Notification[]
  uploadedDocuments        Document[]
  areaManagerApplication   AreaManagerApplication?
  approvalHistories        ApprovalHistory[]             @relation("ApprovalSubject")
  approvalActions          ApprovalHistory[]             @relation("ApprovalActor")
  stores                   Store[]                       @relation("StoreOwner")
  storeReviewActions       StoreAuditLog[]               @relation("StoreAuditActor")
  cartItems                CartItem[]
  orders                   Order[]                       @relation("FarmerOrders")
  partnerFacility          PartnerFacility?
  createdHarvests          HarvestRecord[]               @relation("HarvestFarmer")
  partnerHarvests          HarvestRecord[]               @relation("HarvestBuyer")
  harvestActions           HarvestStatusHistory[]
  farmingPlans             FarmingPlan[]
  weatherObservations      WeatherObservation[]
  regionAssignments        AreaManagerRegionAssignment[] @relation("AssignedAreaManager")
  assignedRegions          AreaManagerRegionAssignment[] @relation("RegionAssignedBy")
  gardenStatusActions      GardenStatusHistory[]         @relation("GardenStatusActor")
  farmerSupplies           FarmerSupply[]
  farmerSupplyTransactions FarmerSupplyTransaction[]
  farmerExpenses           FarmerExpense[]
  pestMonitoringBooks      PestMonitoringBook[]
  receivedGoodsReceipts    GoodsReceipt[]                @relation("GoodsReceiptReceiver")
  rawMaterialReceipts      RawMaterialReceipt[]          @relation("RawMaterialReceiver")
  qualityInspections       QualityInspection[]           @relation("QualityInspector")
  supervisedBatches        ProcessingBatch[]             @relation("ProcessingSupervisor")
  performedProcessingSteps ProcessingStep[]              @relation("StepPerformer")
  issuedTraceCodes         TraceabilityCode[]            @relation("TraceCodeIssuer")
  suspendedTraceCodes      TraceabilityCode[]            @relation("TraceCodeSuspender")
  revokedTraceCodes        TraceabilityCode[]            @relation("TraceCodeRevoker")
  traceEvents              TraceEvent[]
  traceAuditLogs           TraceAuditLog[]
  farmerCommercialLots     CommercialLot[]               @relation("FarmerCommercialLotOwner")
  farmerShipments          Shipment[]                    @relation("FarmerShipmentSender")
  ProcurementOrder         ProcurementOrder[]
  permissionConfig         UserPermissionConfig?

  @@index([role])
  @@index([role, accountStatus, deletedAt])
}

model UserPermissionConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  permissions   String[]
  updatedById   String?
  updatedByName String?  @default("Admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_permission_configs")
}

model PartnerFacility {
  id                  String               @id @default(cuid())
  ownerId             String               @unique
  type                PartnerType
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  identityIssuedDate  DateTime?
  identityIssuedPlace String?
  name                String
  organizationType    String
  taxCode             String?
  businessCode        String?
  phone               String
  email               String?
  website             String?
  address             String
  province            String
  ward                String?
  latitude            Float?
  longitude           Float?
  contactPerson       String?
  purchasingAreas     String[]             @default([])
  processingTypes     String[]             @default([])
  expectedCapacity    Decimal?             @db.Decimal(14, 2)
  capacityUnit        String?
  imageUrls           String[]             @default([])
  description         String?
  status              PartnerStatus        @default(PENDING)
  reviewReason        String?
  submittedAt         DateTime?            @default(now())
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents           PartnerDocument[]
  harvests            HarvestRecord[]
  procurementOrders   ProcurementOrder[]
  collectionLots      CollectionLot[]
  rawMaterialReceipts RawMaterialReceipt[]
  rawMaterialLots     RawMaterialLot[]
  processingBatches   ProcessingBatch[]
  finishedProductLots FinishedProductLot[]
  commercialLots      CommercialLot[]
  shipments           Shipment[]
  expenses            PartnerExpense[]
  paymentRecords      PartnerPaymentRecord[]

  @@index([type, status, deletedAt])
  @@index([province, status])
  @@map("partner_facilities")
}

model PartnerDocument {
  id               String              @id @default(cuid())
  facilityId       String
  type             PartnerDocumentType
  name             String
  documentNumber   String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  storageKey       String?
  fileUrl          String?
  mimeType         String?
  fileSize         Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  facility         PartnerFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@index([expiresAt])
  @@map("partner_documents")
}

model Store {
  id                  String      @id @default(cuid())
  ownerId             String
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  name                String
  taxOrBusinessCode   String?
  address             String
  latitude            Float?
  longitude           Float?
  phone               String
  openingHours        String?
  signboardImageKey   String?
  description         String?
  status              StoreStatus @default(DRAFT)
  reviewReason        String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner              User                @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents          StoreDocument[]
  products           StoreProduct[]
  orders             Order[]
  auditLogs          StoreAuditLog[]
  inventoryDocuments InventoryDocument[]
  expenses           StoreExpense[]
  FarmerSupply       FarmerSupply[]

  @@index([ownerId, status, deletedAt])
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreDocument {
  id               String            @id @default(cuid())
  storeId          String
  type             StoreDocumentType
  name             String
  storageKey       String            @unique
  mimeType         String
  fileSize         Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, deletedAt])
  @@map("store_documents")
}

model StoreProduct {
  id                 String              @id @default(cuid())
  storeId            String
  type               StoreProductType
  name               String
  brand              String?
  manufacturer       String?
  origin             String?
  description        String?
  usagePurpose       String?
  usageInstructions  String?
  packaging          String?
  price              Decimal             @db.Decimal(14, 2)
  salePrice          Decimal?            @db.Decimal(14, 2)
  costPrice          Decimal?            @db.Decimal(14, 2)
  stock              Int                 @default(0)
  unit               String
  imageUrls          String[]            @default([])
  composition        String?
  phiDays            Int?
  safetyWarnings     String?
  status             StoreProductStatus  @default(DRAFT)
  reviewReason       String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  batches            ProductBatch[]

  @@index([storeId, status, deletedAt])
  @@index([type, status, deletedAt])
  @@map("store_products")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  actorId     String?
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  unitCost    Decimal?              @db.Decimal(14, 2)
  totalCost   Decimal?              @db.Decimal(14, 2)
  reference   String?
  note        String?
  createdAt   DateTime              @default(now())
  documentId  String

  product  StoreProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  document InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([documentId])
  @@map("inventory_movements")
}

model InventoryDocument {
  id           String                @id @default(cuid())
  storeId      String
  code         String                @unique
  type         InventoryDocumentType
  businessType InventoryBusinessType
  supplierName String?
  reason       String?
  note         String?
  orderId      String?
  actorId      String?
  actorName    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([type, businessType, createdAt])
  @@map("inventory_documents")
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  productId String
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id                 String               @id @default(cuid())
  orderCode          String               @unique
  farmerId           String
  storeId            String
  status             OrderStatus          @default(PENDING)
  paymentStatus      OrderPaymentStatus   @default(UNPAID)
  paidAmount         Decimal?             @db.Decimal(14, 2)
  paidAt             DateTime?
  recipientName      String
  recipientPhone     String
  shippingAddress    String
  note               String?
  paymentMethod      String               @default("COD")
  subtotal           Decimal              @db.Decimal(14, 2)
  shippingFee        Decimal              @default(20000) @db.Decimal(14, 2)
  rejectionReason    String?
  cancelledAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  farmer             User                 @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  histories          OrderStatusHistory[]
  inventoryDocuments InventoryDocument[]
  farmerSupplies     FarmerSupply[]

  @@index([farmerId, status, deletedAt])
  @@index([storeId, status, deletedAt])
  @@map("orders")
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  productImage   String?
  unitPrice      Decimal          @db.Decimal(14, 2)
  costPrice      Decimal?         @db.Decimal(14, 2)
  quantity       Int
  unit           String
  storeName      String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        StoreProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  batches        OrderItemBatch[]
  farmerSupplies FarmerSupply[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  actorId    String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model StoreExpense {
  id            String               @id @default(cuid())
  storeId       String
  category      StoreExpenseCategory
  expenseDate   DateTime
  amount        Decimal              @db.Decimal(14, 2)
  title         String
  note          String?
  recipient     String?
  paymentMethod String               @default("CASH")
  status        ExpensePaymentStatus @default(PAID)
  paidAmount    Decimal?             @db.Decimal(14, 2)
  receiptImage  String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, expenseDate])
