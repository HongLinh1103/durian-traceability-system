generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hệ thống vai trò người dùng.
enum UserRole {
  ADMIN
  AREA_MANAGER
  FARMER
  STORE_OWNER
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerStatus {
  DRAFT
  PENDING
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerDocumentType {
  BUSINESS_REGISTRATION
  FOOD_SAFETY_CERTIFICATE
  PROCESSING_CERTIFICATE
  STANDARD_CERTIFICATE
  OTHER
}

enum HarvestBuyerType {
  UNDETERMINED
  COLLECTOR
  PROCESSING_FACILITY
  SELF_CONSUMPTION
}

enum HarvestStatus {
  DRAFT
  WAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  HARVESTING
  HARVESTED
  DELIVERY_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HarvestDeliveryMethod {
  BUYER_PICKUP
  FARMER_DELIVERY
  OTHER
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreDocumentType {
  BUSINESS_REGISTRATION
  PESTICIDE_TRADING_LICENSE
  SPECIALIZED_DOCUMENT
}

enum StoreProductType {
  FERTILIZER
  PESTICIDE
  EQUIPMENT
}

enum StoreProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN
  OUT_OF_STOCK
}

enum InventoryMovementType {
  IMPORT
  EXPORT
  ORDER_SALE
  ORDER_RETURN
}

enum InventoryDocumentType {
  PN
  PX
  DC
  HT
}

enum InventoryBusinessType {
  SUPPLIER_IMPORT
  STOCK_REPLENISHMENT
  RETURNED_GOODS_IMPORT
  SALE_EXPORT
  DISPOSAL_EXPORT
  TRANSFER_EXPORT
  STOCKTAKE_INCREASE
  STOCKTAKE_DECREASE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OPENING_BALANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StoreExpenseCategory {
  IMPORT_GOODS
  SHIPPING
  LABOR
  WAREHOUSE
  UTILITIES
  PACKAGING
  DELIVERY
  MARKETING
  MAINTENANCE
  OTHER
}

/// Trạng thái duyệt tài khoản sau onboarding.
enum AccountStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
}

/// Giai đoạn sinh trưởng của cây sầu riêng.
enum GrowthStage {
  POST_HARVEST_RECOVERY
  MAKING_SPROUT
  FLOWER_INDUCTION
  FLOWERING
  FRUIT_SETTING
  FRUIT_GROWING
  PRE_HARVEST
  HARVEST
}

/// Loại hoạt động trong nhật ký canh tác.
enum ActivityType {
  BASE_FERTILIZING
  PLANTING
  MULCHING
  SPRAY_PESTICIDE
  FERTILIZE
  FOLIAR_FERTILIZING
  IRRIGATE
  PRUNE
  WEEDING
  SHOOT_MANAGEMENT
  WATER_STRESS
  FLOWER_INDUCTION
  FLOWER_THINNING
  POLLINATION
  FRUIT_THINNING
  PEST_INSPECTION
  TRACK_FRUIT
  FRUIT_BAGGING
  BRANCH_SUPPORT
  HARVEST
  FRUIT_GRADING
  GARDEN_SANITATION
  OTHER
}

enum PlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum CropSeasonStatus {
  ACTIVE
  CLOSED
}

enum GrowingRegionStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum GardenStatus {
  PENDING
  ACTIVE
  NEEDS_INSPECTION
  SUSPENDED
  INACTIVE
}

/// Trạng thái tuân thủ GACC cho thuốc bảo vệ thực vật.
enum GaccChemicalStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
  UNKNOWN
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// Danh mục Giống sầu riêng (Master Data)
model DurianVariety {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String    @unique
  alternativeName    String?
  scientificName     String?
  description        String?
  origin             String?
  averageHarvestDays Int?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("durian_varieties")
}

model CultivationStageCatalog {
  id         String                       @id @default(cuid())
  code       String                       @unique
  name       String
  sortOrder  Int                          @default(0)
  isActive   Boolean                      @default(true)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  activities CultivationActivityCatalog[]

  @@index([isActive, sortOrder])
  @@map("cultivation_stage_catalogs")
}

model CultivationActivityCatalog {
  id        String                  @id @default(cuid())
  stageId   String
  code      String
  name      String
  sortOrder Int                     @default(0)
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  stage     CultivationStageCatalog @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, code])
  @@index([stageId, isActive, sortOrder])
  @@map("cultivation_activity_catalogs")
}

/// Danh mục Thuốc bảo vệ thực vật (Master Data)
model Pesticide {
  id                  String             @id @default(cuid())
  code                String             @unique
  pesticideName       String?
  tradeName           String
  activeIngredient    String
  concentration       String?
  category            String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]           @default([])
  registrationNumber  String?
  gaccStatus          GaccChemicalStatus @default(UNKNOWN)
  localStatus         String?
  usagePurpose        String?
  targetPests         String?
  usageInstructions   String?
  recommendedDosage   String?
  safetyWarnings      String?
  storageInstructions String?
  phiDays             Int?
  notes               String?
  sourceReference     String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@map("pesticides")
}

/// Danh mục Phân bón (Master Data)
model Fertilizer {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  fertilizerType      String?
  brand               String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]  @default([])
  nutrientComposition String?
  mainUses            String?
  targetCrops         String?
  usageInstructions   String?
  recommendedDosage   String?
  applicationMethod   String?
  safetyWarnings      String?
  storageInstructions String?
  sourceReference     String?
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@map("fertilizers")
}

model User {
  id                      String        @id @default(cuid())
  phone                   String        @unique
  email                   String?       @unique
  password                String
  fullName                String?
  avatar                  String?
  birthDate               DateTime?
  gender                  String?
  address                 String?
  province                String?
  district                String?
  ward                    String?
  registrationName        String?
  registeredAreaSize      Float?
  registeredTotalTrees    Int?
  registeredDurianVariety String?
  role                    UserRole
  isApproved              Boolean       @default(false)
  failedAttempts          Int           @default(0)
  lockUntil               DateTime?
  isLocked                Boolean       @default(false)
  accountStatus           AccountStatus @default(PENDING)
  approvedAt              DateTime?
  lastLoginAt             DateTime?
  passwordUpdatedAt       DateTime?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  farms                  Farm[]
  notifications          Notification[]
  uploadedDocuments      Document[]
  areaManagerApplication AreaManagerApplication?
  approvalHistories      ApprovalHistory[]       @relation("ApprovalSubject")
  approvalActions        ApprovalHistory[]       @relation("ApprovalActor")
  stores                 Store[]                 @relation("StoreOwner")
  storeReviewActions     StoreAuditLog[]         @relation("StoreAuditActor")
  cartItems              CartItem[]
  orders                 Order[]                 @relation("FarmerOrders")
  partnerFacility        PartnerFacility?
  createdHarvests        HarvestRecord[]         @relation("HarvestFarmer")
  partnerHarvests        HarvestRecord[]         @relation("HarvestBuyer")
  harvestActions         HarvestStatusHistory[]
  farmingPlans           FarmingPlan[]
  weatherObservations    WeatherObservation[]
  regionAssignments     AreaManagerRegionAssignment[] @relation("AssignedAreaManager")
  assignedRegions       AreaManagerRegionAssignment[] @relation("RegionAssignedBy")
  gardenStatusActions   GardenStatusHistory[]          @relation("GardenStatusActor")
  farmerSupplies         FarmerSupply[]
  farmerSupplyTransactions FarmerSupplyTransaction[]
  farmerExpenses         FarmerExpense[]
  pestMonitoringBooks    PestMonitoringBook[]

  @@index([role])
  @@index([role, accountStatus, deletedAt])
}

model PartnerFacility {
  id                  String            @id @default(cuid())
  ownerId             String            @unique
  type                PartnerType
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  identityIssuedDate  DateTime?
  identityIssuedPlace String?
  name                String
  organizationType    String
  taxCode             String?
  businessCode        String?
  phone               String
  email               String?
  website             String?
  address             String
  province            String
  ward                String?
  latitude            Float?
  longitude           Float?
  contactPerson       String?
  purchasingAreas     String[]          @default([])
  processingTypes     String[]          @default([])
  expectedCapacity    Decimal?          @db.Decimal(14, 2)
  capacityUnit        String?
  imageUrls           String[]          @default([])
  description         String?
  status              PartnerStatus     @default(PENDING)
  reviewReason        String?
  submittedAt         DateTime?         @default(now())
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents           PartnerDocument[]
  harvests            HarvestRecord[]

  @@index([type, status, deletedAt])
  @@index([province, status])
  @@map("partner_facilities")
}

model PartnerDocument {
  id               String              @id @default(cuid())
  facilityId       String
  type             PartnerDocumentType
  name             String
  documentNumber   String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  storageKey       String?
  fileUrl          String?
  mimeType         String?
  fileSize         Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  facility         PartnerFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@index([expiresAt])
  @@map("partner_documents")
}

model Store {
  id                  String      @id @default(cuid())
  ownerId             String
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  name                String
  taxOrBusinessCode   String?
  address             String
  latitude            Float?
  longitude           Float?
  phone               String
  openingHours        String?
  signboardImageKey   String?
  description         String?
  status              StoreStatus @default(DRAFT)
  reviewReason        String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner              User                @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents          StoreDocument[]
  products           StoreProduct[]
  orders             Order[]
  auditLogs          StoreAuditLog[]
  inventoryDocuments InventoryDocument[]
  expenses           StoreExpense[]

  @@index([ownerId, status, deletedAt])
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreDocument {
  id               String            @id @default(cuid())
  storeId          String
  type             StoreDocumentType
  name             String
  storageKey       String            @unique
  mimeType         String
  fileSize         Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, deletedAt])
  @@map("store_documents")
}

model StoreProduct {
  id                 String              @id @default(cuid())
  storeId            String
  type               StoreProductType
  name               String
  brand              String?
  manufacturer       String?
  origin             String?
  description        String?
  usagePurpose       String?
  usageInstructions  String?
  packaging          String?
  price              Decimal             @db.Decimal(14, 2)
  salePrice          Decimal?            @db.Decimal(14, 2)
  costPrice          Decimal?            @db.Decimal(14, 2)
  stock              Int                 @default(0)
  unit               String
  imageUrls          String[]            @default([])
  composition        String?
  phiDays            Int?
  safetyWarnings     String?
  status             StoreProductStatus  @default(DRAFT)
  reviewReason       String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([storeId, status, deletedAt])
  @@index([type, status, deletedAt])
  @@map("store_products")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  actorId     String?
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  unitCost    Decimal?              @db.Decimal(14, 2)
  totalCost   Decimal?              @db.Decimal(14, 2)
  reference   String?
  note        String?
  createdAt   DateTime              @default(now())
  documentId  String

  product  StoreProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  document InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([documentId])
  @@map("inventory_movements")
}

model InventoryDocument {
  id           String                @id @default(cuid())
  storeId      String
  code         String                @unique
  type         InventoryDocumentType
  businessType InventoryBusinessType
  supplierName String?
  reason       String?
  note         String?
  orderId      String?
  actorId      String?
  actorName    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([type, businessType, createdAt])
  @@map("inventory_documents")
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  productId String
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id                 String               @id @default(cuid())
  orderCode          String               @unique
  farmerId           String
  storeId            String
  status             OrderStatus          @default(PENDING)
  paymentStatus      OrderPaymentStatus   @default(UNPAID)
  paidAmount         Decimal?             @db.Decimal(14, 2)
  paidAt             DateTime?
  recipientName      String
  recipientPhone     String
  shippingAddress    String
  note               String?
  paymentMethod      String               @default("COD")
  subtotal           Decimal              @db.Decimal(14, 2)
  shippingFee        Decimal              @default(20000) @db.Decimal(14, 2)
  rejectionReason    String?
  cancelledAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  farmer             User                 @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  histories          OrderStatusHistory[]
  inventoryDocuments InventoryDocument[]

  @@index([farmerId, status, deletedAt])
  @@index([storeId, status, deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String        @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  unitPrice    Decimal       @db.Decimal(14, 2)
  costPrice    Decimal?      @db.Decimal(14, 2)
  quantity     Int
  unit         String
  storeName    String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  actorId    String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model StoreExpense {
  id            String               @id @default(cuid())
  storeId       String
  category      StoreExpenseCategory
  expenseDate   DateTime
  amount        Decimal              @db.Decimal(14, 2)
  title         String
  note          String?
  recipient     String?
  paymentMethod String               @default("CASH")
  status        ExpensePaymentStatus @default(PAID)
  paidAmount    Decimal?             @db.Decimal(14, 2)
  receiptImage  String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, expenseDate])
  @@index([storeId, category])
  @@map("store_expenses")
}

model StoreAuditLog {
  id         String       @id @default(cuid())
  storeId    String
  actorId    String?
  action     String
  fromStatus StoreStatus?
  toStatus   StoreStatus?
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor      User?        @relation("StoreAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("store_audit_logs")
}

model ApprovalHistory {
  id         String         @id @default(cuid())
  subjectId  String
  actorId    String
  action     String
  fromStatus AccountStatus?
  toStatus   AccountStatus?
  reason     String?
  details    Json?
  createdAt  DateTime       @default(now())

  subject User @relation("ApprovalSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  actor   User @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_histories")
}

model AreaManagerApplication {
  id                    String   @id @default(cuid())
  userId                String   @unique
  identityNumber        String   @unique
  identityIssuedDate    DateTime
  identityIssuedPlace   String
  identityFrontKey      String
  identityBackKey       String
  organizationName      String
  taxCode               String?
  position              String
  officeProvince        String
  officeDistrict        String
  officeWard            String
  officeDetailedAddress String
  authorityDocumentKey  String
  managedRegions        Json
  status                AccountStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewReason          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationName])
  @@map("area_manager_applications")
}

model Document {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String?
  category    String
  status      DocumentStatus @default(DRAFT)
  fileName    String
  fileUrl     String
  storageKey  String         @unique
  mimeType    String
  fileSize    Int
  uploaderId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, publishedAt])
  @@index([category])
  @@map("documents")
}

model NewsArticle {
  id                String     @id @default(cuid())
  title             String
  description       String?
  imageUrl          String?
  sourceName        String
  originalUrl       String     @unique
  sourcePublishedAt DateTime?
  status            NewsStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Farm {
  id              String   @id @default(cuid())
  farmCode        String   @unique
  farmName        String
  areaSize        Float
  totalTrees      Int
  durianVariety   String
  address         String
  province        String?
  district        String?
  ward            String?
  areaUnit        String   @default("HECTARE")
  notes           String?
  latitude        Float?
  longitude       Float?
  growingRegion   String?
  growingRegionId String?
  isActive        Boolean  @default(true)
  status          GardenStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  isInSeason      Boolean  @default(true)
  farmerId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmer              User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  region              GrowingRegion?       @relation(fields: [growingRegionId], references: [id], onDelete: SetNull)
  farmingLogs         FarmingLog[]
  harvests            HarvestRecord[]
  farmingPlans        FarmingPlan[]
  weatherObservations WeatherObservation[]
  cropSeasons         CropSeason[]
  farmerSupplyTransactions FarmerSupplyTransaction[]
  farmerExpenses         FarmerExpense[]
  pestMonitoringBooks    PestMonitoringBook[]
  statusHistories         GardenStatusHistory[]

  @@index([farmerId])
  @@index([farmCode])
  @@index([growingRegionId])
}

model GardenStatusHistory {
  id         String       @id @default(cuid())
  farmId     String
  actorId    String
  fromStatus GardenStatus?
  toStatus   GardenStatus
  reason     String
  createdAt  DateTime     @default(now())

  farm       Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  actor      User         @relation("GardenStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([farmId, createdAt])
  @@map("garden_status_histories")
}

model CropSeason {
  id              String           @id @default(cuid())
  farmId          String
  name            String
  year            Int
  sequence        Int              @default(1)
  status          CropSeasonStatus @default(ACTIVE)
  startedAt       DateTime
  startingStage   GrowthStage      @default(POST_HARVEST_RECOVERY)
  notes           String?
  expectedEndAt   DateTime?
  closedAt        DateTime?
  closingNote     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  farm            Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmingLogs     FarmingLog[]
  harvests        HarvestRecord[]
  farmerSupplyTransactions FarmerSupplyTransaction[]
  farmerExpenses         FarmerExpense[]
  pestMonitoringBooks    PestMonitoringBook[]

  @@unique([farmId, year, sequence])
  @@index([farmId, status])
  @@map("crop_seasons")
}

model WeatherObservation {
  id             String    @id @default(cuid())
  farmerId       String
  farmId         String
  observedAt     DateTime
  timeOfDay      String?
  condition      String
  temperature    Float?
  temperatureMax Float?
  temperatureMin Float?
  humidity       Float?
  soilCondition  String?
  soilHumidity   Float?
  rainLevel      String?
  rainStartedAt  String?
  rainfallMm     Float?
  windLevel      String
  windDirection  String?
  windSpeed      Float?
  phenomena      String[]  @default([])
  note           String?
  images         String[]  @default([])
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  farmer User @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmerId, observedAt])
  @@index([farmId, observedAt])
  @@map("weather_observations")
}

model HarvestRecord {
  id                       String                 @id @default(cuid())
  code                     String                 @unique
  farmId                   String
  farmerId                 String
  cropSeasonId             String?
  buyerType                HarvestBuyerType       @default(UNDETERMINED)
  buyerFacilityId          String?
  buyerUserId              String?
  status                   HarvestStatus          @default(DRAFT)
  expectedHarvestDate      DateTime
  durianVariety            String
  plotArea                 String?
  expectedTreeCount        Int?
  expectedFruitCount       Int?
  expectedWeight           Decimal                @db.Decimal(14, 2)
  weightUnit               String                 @default("kg")
  fruitCondition           String?
  evidenceImages           String[]               @default([])
  expectedSaleWeight       Decimal?               @db.Decimal(14, 2)
  expectedPricePerKg       Decimal?               @db.Decimal(14, 2)
  expectedBuyerArrivalDate DateTime?
  deliveryMethod           HarvestDeliveryMethod?
  transactionNote          String?
  rejectionReason          String?
  actualStartedAt          DateTime?
  actualHarvestedAt        DateTime?
  actualTreeCount          Int?
  actualFruitCount         Int?
  actualWeight             Decimal?               @db.Decimal(14, 2)
  actualImages             String[]               @default([])
  actualNote               String?
  farmerDeliveredAt        DateTime?
  buyerReceivedAt          DateTime?
  deliveredWeight          Decimal?               @db.Decimal(14, 2)
  receivedWeight           Decimal?               @db.Decimal(14, 2)
  weightDifferenceReason   String?
  completedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  farm                     Farm                   @relation(fields: [farmId], references: [id], onDelete: Restrict)
  farmer                   User                   @relation("HarvestFarmer", fields: [farmerId], references: [id], onDelete: Restrict)
  buyerFacility            PartnerFacility?       @relation(fields: [buyerFacilityId], references: [id], onDelete: SetNull)
  buyerUser                User?                  @relation("HarvestBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  histories                HarvestStatusHistory[]
  varietyItems             HarvestVarietyItem[]
  farmingLog               FarmingLog?
  cropSeason               CropSeason?             @relation(fields: [cropSeasonId], references: [id], onDelete: SetNull)

  @@index([farmerId, status, createdAt])
  @@index([buyerUserId, status, createdAt])
  @@index([farmId, expectedHarvestDate])
  @@index([cropSeasonId])
  @@map("harvest_records")
}

model HarvestVarietyItem {
  id                 String        @id @default(cuid())
  harvestId          String
  durianVariety      String
  expectedWeight     Decimal       @db.Decimal(14, 2)
  expectedPricePerKg Decimal?      @db.Decimal(14, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  harvest            HarvestRecord @relation(fields: [harvestId], references: [id], onDelete: Cascade)

  @@unique([harvestId, durianVariety])
  @@index([harvestId])
  @@map("harvest_variety_items")
}

model HarvestStatusHistory {
  id         String         @id @default(cuid())
  harvestId  String
  actorId    String
  fromStatus HarvestStatus?
  toStatus   HarvestStatus
  note       String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  harvest    HarvestRecord  @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([harvestId, createdAt])
  @@map("harvest_status_histories")
}

model GrowingRegion {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  province      String
  district      String?
  ward          String?
  cropVarieties String[]  @default([])
  status        GrowingRegionStatus @default(ACTIVE)
  latitude      Float?
  longitude     Float?
  boundary      Json?
  areaSize      Float?
  cropType      String     @default("Sầu riêng")
  approvalCode  String?
  approvalIssuedAt DateTime?
  exportMarkets String[]   @default([])
  managingOrganization String?
  certificateUrls String[] @default([])
  isActive      Boolean   @default(true)
  approvedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farms Farm[]
  managerAssignments AreaManagerRegionAssignment[]

  @@index([province, district, ward, isActive])
  @@map("growing_regions")
}

model AreaManagerRegionAssignment {
  id              String    @id @default(cuid())
  areaManagerId   String
  growingRegionId String
  assignedAt      DateTime  @default(now())
  assignedById    String
  endedAt         DateTime?
  isActive        Boolean   @default(true)
  note            String?

  areaManager     User      @relation("AssignedAreaManager", fields: [areaManagerId], references: [id], onDelete: Restrict)
  growingRegion   GrowingRegion @relation(fields: [growingRegionId], references: [id], onDelete: Restrict)
  assignedBy      User      @relation("RegionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([areaManagerId, isActive])
  @@index([growingRegionId, isActive])
  @@map("area_manager_region_assignments")
}

model FarmingLog {
  id              String       @id @default(cuid())
  farmId          String
  cropSeasonId    String?
  stage           GrowthStage
  actionDate      DateTime
  activityType    ActivityType
  otherActivity   String?
  chemicalName    String?
  dosage          String?
  phiDays         Int?
  isGACCCompliant Boolean      @default(true)
  notes           String?
  images          String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  harvestRecordId String?      @unique
  planId          String?      @unique

  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  harvestRecord HarvestRecord? @relation(fields: [harvestRecordId], references: [id], onDelete: SetNull)
  plan          FarmingPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  cropSeason    CropSeason?    @relation(fields: [cropSeasonId], references: [id], onDelete: SetNull)
  materialsUsed FarmingLogMaterial[]
  supplyTransactions FarmerSupplyTransaction[]
  pestTreatments PestTreatment[]

  @@index([farmId, actionDate])
  @@index([cropSeasonId, actionDate])
  @@index([stage])
  @@index([activityType])
}

model FarmingPlan {
  id            String       @id @default(cuid())
  farmerId      String
  farmId        String
  plannedDate   DateTime
  title         String
  stage         GrowthStage
  activityType  ActivityType
  otherActivity String?
  notes         String?
  status        PlanStatus   @default(PLANNED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  farmer User        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  log    FarmingLog?

  @@index([farmerId, plannedDate, status])
  @@index([farmId, plannedDate])
  @@map("farming_plans")
}

model ProhibitedChemical {
  id        String   @id @default(cuid())
  name      String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}

enum SupplyType {
  FERTILIZER
  PESTICIDE
  EQUIPMENT
  OTHER
}

enum SupplyTransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum FarmerExpenseCategory {
  FERTILIZER
  PESTICIDE
  LABOR
  ELECTRICITY_WATER
  MACHINERY
  TRANSPORT
  HARVESTING
  TESTING
  OTHER
}

model FarmerSupply {
  id                String       @id @default(cuid())
  farmerId          String
  name              String
  type              SupplyType
  brand             String?
  unit              String
  quantity          Float        @default(0)
  unitPrice         Decimal      @default(0) @db.Decimal(14, 2)
  phiDays           Int?
  activeIngredients String?
  orderItemId       String?
  productId         String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  farmer            User         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  transactions      FarmerSupplyTransaction[]
  logMaterials      FarmingLogMaterial[]

  @@index([farmerId, type])
  @@map("farmer_supplies")
}

model FarmerSupplyTransaction {
  id           String                @id @default(cuid())
  supplyId     String
  farmerId     String
  farmId       String?
  cropSeasonId String?
  farmingLogId String?
  type         SupplyTransactionType
  quantity     Float
  unitPrice    Decimal               @db.Decimal(14, 2)
  totalAmount  Decimal               @db.Decimal(14, 2)
  stage        GrowthStage?
  activityType ActivityType?
  purpose      String?
  actionDate   DateTime              @default(now())
  notes        String?
  createdAt    DateTime              @default(now())

  supply       FarmerSupply          @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  farmer       User                  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm         Farm?                 @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropSeason   CropSeason?           @relation(fields: [cropSeasonId], references: [id], onDelete: SetNull)
  farmingLog   FarmingLog?           @relation(fields: [farmingLogId], references: [id], onDelete: SetNull)

  @@index([farmerId, type, actionDate])
  @@index([cropSeasonId, actionDate])
  @@index([farmId, actionDate])
  @@map("farmer_supply_transactions")
}

model FarmingLogMaterial {
  id            String        @id @default(cuid())
  farmingLogId  String
  supplyId      String?
  supplyName    String
  supplyType    SupplyType
  quantity      Float
  unit          String
  unitPrice     Decimal       @default(0) @db.Decimal(14, 2)
  totalCost     Decimal       @default(0) @db.Decimal(14, 2)
  transactionId String?
  createdAt     DateTime      @default(now())

  farmingLog    FarmingLog    @relation(fields: [farmingLogId], references: [id], onDelete: Cascade)
  supply        FarmerSupply? @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([farmingLogId])
  @@index([supplyId])
  @@map("farming_log_materials")
}

model FarmerExpense {
  id           String                @id @default(cuid())
  farmerId     String
  farmId       String
  cropSeasonId String
  category     FarmerExpenseCategory
  title        String
  amount       Decimal               @db.Decimal(14, 2)
  expenseDate  DateTime
  stage        GrowthStage?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  farmer       User                  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm         Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropSeason   CropSeason            @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)

  @@index([farmerId, expenseDate])
  @@index([cropSeasonId, category])
  @@index([farmId, expenseDate])
  @@map("farmer_expenses")
}

enum PestMonitoringStatus {
  ACTIVE
  CLOSED
}

enum PestTrapStatus {
  ACTIVE
  INACTIVE
  DAMAGED
}

model PestMonitoringBook {
  id                 String               @id @default(cuid())
  farmerId           String
  farmId             String
  cropSeasonId       String
  pestName           String
  scientificName     String?
  trapType           String
  attractant         String?
  startDate          DateTime             @default(now())
  checkFrequencyDays Int                  @default(7)
  status             PestMonitoringStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  farmer             User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm               Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropSeason         CropSeason           @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)
  traps              PestTrap[]
  inspections        PestInspection[]
  treatments         PestTreatment[]

  @@index([farmerId, status])
  @@index([farmId, cropSeasonId])
  @@map("pest_monitoring_books")
}

model PestTrap {
  id               String               @id @default(cuid())
  monitoringBookId String
  trapCode         String
  trapType         String
  locationName     String
  latitude         Float?
  longitude        Float?
  installedDate    DateTime             @default(now())
  status           PestTrapStatus       @default(ACTIVE)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  monitoringBook   PestMonitoringBook   @relation(fields: [monitoringBookId], references: [id], onDelete: Cascade)
  inspectionItems  PestInspectionItem[]

  @@index([monitoringBookId, status])
  @@map("pest_traps")
}

model PestInspection {
  id               String               @id @default(cuid())
  monitoringBookId String
  inspectionDate   DateTime             @default(now())
  inspectorName    String
  totalPestsCount  Int                  @default(0)
  densityLevel     String?
  weatherCondition String?
  actionNeeded     Boolean              @default(false)
  actionNote       String?
  images           String[]             @default([])
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  monitoringBook   PestMonitoringBook   @relation(fields: [monitoringBookId], references: [id], onDelete: Cascade)
  items            PestInspectionItem[]

  @@index([monitoringBookId, inspectionDate])
  @@map("pest_inspections")
}

model PestInspectionItem {
  id           String         @id @default(cuid())
  inspectionId String
  trapId       String
  pestsCount   Int            @default(0)
  baitStatus   String?
  notes        String?

  inspection   PestInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  trap         PestTrap       @relation(fields: [trapId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([trapId])
  @@map("pest_inspection_items")
}

model PestTreatment {
  id               String             @id @default(cuid())
  monitoringBookId String
  treatmentDate    DateTime           @default(now())
  treatmentType    String
  productUsed      String?
  dosage           String?
  areaTreated      String?
  resultNotes      String?
  farmingLogId     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  monitoringBook   PestMonitoringBook @relation(fields: [monitoringBookId], references: [id], onDelete: Cascade)
  farmingLog       FarmingLog?        @relation(fields: [farmingLogId], references: [id], onDelete: SetNull)

  @@index([monitoringBookId, treatmentDate])
  @@map("pest_treatments")
}
