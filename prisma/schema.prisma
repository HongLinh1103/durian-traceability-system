generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hệ thống vai trò người dùng.
enum UserRole {
  ADMIN
  AREA_MANAGER
  EXPORTER
  FARMER
  PACKHOUSE_MANAGER
  PACKHOUSE_STAFF
}

/// Trạng thái duyệt tài khoản sau onboarding.
enum AccountStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
}

/// Giai đoạn sinh trưởng của cây sầu riêng.
enum GrowthStage {
  MAKING_SPROUT
  FLOWERING
  FRUIT_SETTING
  FRUIT_GROWING
  HARVEST
}

/// Loại hoạt động trong nhật ký canh tác.
enum ActivityType {
  SPRAY_PESTICIDE
  FERTILIZE
  IRRIGATE
  PRUNE
  WEEDING
}

/// Phân hạng chất lượng lô hàng.
enum QualityGrade {
  TYPE_1
  TYPE_2
  CREAM
}

/// Trạng thái xử lý của lô hàng.
enum BatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PACKED
  SHIPPED
  REJECTED
}

/// Trạng thái tuân thủ GACC cho thuốc bảo vệ thực vật.
enum GaccChemicalStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
  UNKNOWN
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// Danh mục Giống sầu riêng (Master Data)
model DurianVariety {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String    @unique
  scientificName     String?
  description        String?
  origin             String?
  averageHarvestDays Int?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("durian_varieties")
}

/// Danh mục Thuốc bảo vệ thực vật (Master Data)
model Pesticide {
  id                 String             @id @default(cuid())
  code               String             @unique
  tradeName          String
  activeIngredient   String
  category           String?
  manufacturer       String?
  registrationNumber String?
  gaccStatus         GaccChemicalStatus @default(UNKNOWN)
  localStatus        String?
  usagePurpose       String?
  recommendedDosage  String?
  phiDays            Int?
  notes              String?
  sourceReference    String?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@map("pesticides")
}

/// Danh mục Phân bón (Master Data)
model Fertilizer {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  fertilizerType      String?
  brand               String?
  manufacturer        String?
  nutrientComposition String?
  usageInstructions   String?
  recommendedDosage   String?
  applicationMethod   String?
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@map("fertilizers")
}

model User {
  id             String        @id @default(cuid())
  phone          String        @unique
  email          String?       @unique
  password       String
  fullName       String?
  avatar         String?
  address        String?
  province       String?
  district       String?
  ward           String?
  registrationName String?
  registeredAreaSize Float?
  registeredTotalTrees Int?
  registeredDurianVariety String?
  role           UserRole
  isApproved     Boolean       @default(false)
  failedAttempts Int           @default(0)
  lockUntil      DateTime?
  isLocked       Boolean       @default(false)
  accountStatus  AccountStatus @default(PENDING)
  approvedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  farms         Farm[]
  packhouses    Packhouse[]
  notifications Notification[]
  uploadedDocuments Document[]
  areaManagerApplication AreaManagerApplication?
  approvalHistories ApprovalHistory[] @relation("ApprovalSubject")
  approvalActions ApprovalHistory[] @relation("ApprovalActor")

  @@index([role])
  @@index([role, accountStatus, deletedAt])
}

model ApprovalHistory {
  id          String   @id @default(cuid())
  subjectId   String
  actorId     String
  action      String
  fromStatus  AccountStatus?
  toStatus    AccountStatus?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  subject User @relation("ApprovalSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  actor   User @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_histories")
}

model AreaManagerApplication {
  id                   String   @id @default(cuid())
  userId               String   @unique
  identityNumber       String   @unique
  identityIssuedDate   DateTime
  identityIssuedPlace  String
  identityFrontKey     String
  identityBackKey      String
  organizationName     String
  taxCode              String?
  position             String
  officeProvince       String
  officeDistrict       String
  officeWard           String
  officeDetailedAddress String
  authorityDocumentKey String
  managedRegions       Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationName])
  @@map("area_manager_applications")
}

model Document {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  summary      String?
  category     String
  status       DocumentStatus @default(DRAFT)
  fileName     String
  fileUrl      String
  storageKey   String         @unique
  mimeType     String
  fileSize     Int
  uploaderId   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  publishedAt  DateTime?
  deletedAt    DateTime?

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, publishedAt])
  @@index([category])
  @@map("documents")
}

model NewsArticle {
  id          String     @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  sourceName  String
  originalUrl String     @unique
  sourcePublishedAt DateTime?
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Farm {
  id            String   @id @default(cuid())
  farmCode      String   @unique
  farmName      String
  areaSize      Float
  totalTrees    Int
  durianVariety String
  address       String
  province      String?
  district      String?
  ward          String?
  areaUnit      String   @default("HECTARE")
  notes         String?
  latitude      Float?
  longitude     Float?
  growingRegion String?
  growingRegionId String?
  isActive      Boolean  @default(true)
  isInSeason    Boolean  @default(true)
  farmerId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farmer         User           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  region         GrowingRegion? @relation(fields: [growingRegionId], references: [id], onDelete: SetNull)
  farmingLogs    FarmingLog[]
  harvestBatches HarvestBatch[]

  @@index([farmerId])
  @@index([farmCode])
  @@index([growingRegionId])
}

model GrowingRegion {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  province      String
  district      String?
  ward          String?
  cropVarieties String[] @default([])
  isActive      Boolean  @default(true)
  approvedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farms Farm[]

  @@index([province, district, ward, isActive])
  @@map("growing_regions")
}

model FarmingLog {
  id              String       @id @default(cuid())
  farmId          String
  stage           GrowthStage
  actionDate      DateTime
  activityType    ActivityType
  chemicalName    String?
  dosage          String?
  phiDays         Int?
  isGACCCompliant Boolean      @default(true)
  notes           String?
  images          String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, actionDate])
  @@index([stage])
  @@index([activityType])
}

model Packhouse {
  id            String   @id @default(cuid())
  packhouseCode String   @unique
  packhouseName String
  address       String
  managerId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manager        User           @relation(fields: [managerId], references: [id], onDelete: Cascade)
  harvestBatches HarvestBatch[]

  @@index([managerId])
  @@index([packhouseCode])
}

model HarvestBatch {
  id            String       @id @default(cuid())
  batchCode     String       @unique
  farmId        String
  packhouseId   String
  harvestDate   DateTime
  totalWeightKg Float
  qualityGrade  QualityGrade
  status        BatchStatus  @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict)
  packhouse Packhouse @relation(fields: [packhouseId], references: [id], onDelete: Restrict)
  qrCode    QRCode?

  @@index([farmId, harvestDate])
  @@index([packhouseId])
  @@index([status])
}

model QRCode {
  id           String   @id @default(cuid())
  qrCodeString String   @unique
  batchId      String   @unique
  scanCount    Int      @default(0)
  createdAt    DateTime @default(now())

  batch HarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model ProhibitedChemical {
  id        String   @id @default(cuid())
  name      String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}
