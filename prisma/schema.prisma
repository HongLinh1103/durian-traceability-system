generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hệ thống vai trò người dùng.
enum UserRole {
  ADMIN
  AREA_MANAGER
  FARMER
  STORE_OWNER
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerStatus {
  DRAFT
  PENDING
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum PartnerType {
  COLLECTOR
  PROCESSING_FACILITY
}

enum PartnerDocumentType {
  BUSINESS_REGISTRATION
  FOOD_SAFETY_CERTIFICATE
  PROCESSING_CERTIFICATE
  STANDARD_CERTIFICATE
  OTHER
}

enum HarvestBuyerType {
  UNDETERMINED
  COLLECTOR
  PROCESSING_FACILITY
  SELF_CONSUMPTION
}

enum HarvestStatus {
  DRAFT
  WAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  HARVESTING
  HARVESTED
  DELIVERY_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HarvestDeliveryMethod {
  BUYER_PICKUP
  FARMER_DELIVERY
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreDocumentType {
  BUSINESS_REGISTRATION
  PESTICIDE_TRADING_LICENSE
  SPECIALIZED_DOCUMENT
}

enum StoreProductType {
  FERTILIZER
  PESTICIDE
}

enum StoreProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN
  OUT_OF_STOCK
}

enum InventoryMovementType {
  IMPORT
  EXPORT
  ORDER_SALE
  ORDER_RETURN
}

enum InventoryDocumentType {
  PN
  PX
  DC
  HT
}

enum InventoryBusinessType {
  SUPPLIER_IMPORT
  STOCK_REPLENISHMENT
  RETURNED_GOODS_IMPORT
  SALE_EXPORT
  DISPOSAL_EXPORT
  TRANSFER_EXPORT
  STOCKTAKE_INCREASE
  STOCKTAKE_DECREASE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OPENING_BALANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

/// Trạng thái duyệt tài khoản sau onboarding.
enum AccountStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
}

/// Giai đoạn sinh trưởng của cây sầu riêng.
enum GrowthStage {
  POST_HARVEST_RECOVERY
  MAKING_SPROUT
  FLOWER_INDUCTION
  FLOWERING
  FRUIT_SETTING
  FRUIT_GROWING
  PRE_HARVEST
  HARVEST
}

/// Loại hoạt động trong nhật ký canh tác.
enum ActivityType {
  BASE_FERTILIZING
  PLANTING
  MULCHING
  SPRAY_PESTICIDE
  FERTILIZE
  FOLIAR_FERTILIZING
  IRRIGATE
  PRUNE
  WEEDING
  SHOOT_MANAGEMENT
  WATER_STRESS
  FLOWER_INDUCTION
  FLOWER_THINNING
  POLLINATION
  FRUIT_THINNING
  PEST_INSPECTION
  TRACK_FRUIT
  FRUIT_BAGGING
  BRANCH_SUPPORT
  HARVEST
  FRUIT_GRADING
  GARDEN_SANITATION
  OTHER
}

/// Trạng thái tuân thủ GACC cho thuốc bảo vệ thực vật.
enum GaccChemicalStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
  UNKNOWN
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// Danh mục Giống sầu riêng (Master Data)
model DurianVariety {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String    @unique
  scientificName     String?
  description        String?
  origin             String?
  averageHarvestDays Int?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("durian_varieties")
}

/// Danh mục Thuốc bảo vệ thực vật (Master Data)
model Pesticide {
  id                  String             @id @default(cuid())
  code                String             @unique
  pesticideName       String?
  tradeName           String
  activeIngredient    String
  concentration       String?
  category            String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]           @default([])
  registrationNumber  String?
  gaccStatus          GaccChemicalStatus @default(UNKNOWN)
  localStatus         String?
  usagePurpose        String?
  targetPests         String?
  usageInstructions   String?
  recommendedDosage   String?
  safetyWarnings      String?
  storageInstructions String?
  phiDays             Int?
  notes               String?
  sourceReference     String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@map("pesticides")
}

/// Danh mục Phân bón (Master Data)
model Fertilizer {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  fertilizerType      String?
  brand               String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]  @default([])
  nutrientComposition String?
  mainUses            String?
  targetCrops         String?
  usageInstructions   String?
  recommendedDosage   String?
  applicationMethod   String?
  safetyWarnings      String?
  storageInstructions String?
  sourceReference     String?
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@map("fertilizers")
}

model User {
  id                      String        @id @default(cuid())
  phone                   String        @unique
  email                   String?       @unique
  password                String
  fullName                String?
  avatar                  String?
  address                 String?
  province                String?
  district                String?
  ward                    String?
  registrationName        String?
  registeredAreaSize      Float?
  registeredTotalTrees    Int?
  registeredDurianVariety String?
  role                    UserRole
  isApproved              Boolean       @default(false)
  failedAttempts          Int           @default(0)
  lockUntil               DateTime?
  isLocked                Boolean       @default(false)
  accountStatus           AccountStatus @default(PENDING)
  approvedAt              DateTime?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  farms                  Farm[]
  notifications          Notification[]
  uploadedDocuments      Document[]
  areaManagerApplication AreaManagerApplication?
  approvalHistories      ApprovalHistory[]       @relation("ApprovalSubject")
  approvalActions        ApprovalHistory[]       @relation("ApprovalActor")
  stores                 Store[]                 @relation("StoreOwner")
  storeReviewActions     StoreAuditLog[]         @relation("StoreAuditActor")
  cartItems              CartItem[]
  orders                 Order[]                 @relation("FarmerOrders")
  partnerFacility        PartnerFacility?
  createdHarvests        HarvestRecord[]         @relation("HarvestFarmer")
  partnerHarvests        HarvestRecord[]         @relation("HarvestBuyer")
  harvestActions         HarvestStatusHistory[]

  @@index([role])
  @@index([role, accountStatus, deletedAt])
}

model PartnerFacility {
  id                  String            @id @default(cuid())
  ownerId             String            @unique
  type                PartnerType
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  identityIssuedDate  DateTime?
  identityIssuedPlace String?
  name                String
  organizationType    String
  taxCode             String?
  businessCode        String?
  phone               String
  email               String?
  website             String?
  address             String
  province            String
  ward                String?
  latitude            Float?
  longitude           Float?
  contactPerson       String?
  purchasingAreas     String[]          @default([])
  processingTypes     String[]          @default([])
  expectedCapacity    Decimal?          @db.Decimal(14, 2)
  capacityUnit        String?
  imageUrls           String[]          @default([])
  description         String?
  status              PartnerStatus     @default(PENDING)
  reviewReason        String?
  submittedAt         DateTime?         @default(now())
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents           PartnerDocument[]
  harvests            HarvestRecord[]

  @@index([type, status, deletedAt])
  @@index([province, status])
  @@map("partner_facilities")
}

model PartnerDocument {
  id               String              @id @default(cuid())
  facilityId       String
  type             PartnerDocumentType
  name             String
  documentNumber   String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  storageKey       String?
  fileUrl          String?
  mimeType         String?
  fileSize         Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  facility         PartnerFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@index([expiresAt])
  @@map("partner_documents")
}

model Store {
  id                  String      @id @default(cuid())
  ownerId             String
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  name                String
  taxOrBusinessCode   String?
  address             String
  latitude            Float?
  longitude           Float?
  phone               String
  openingHours        String?
  signboardImageKey   String?
  description         String?
  status              StoreStatus @default(DRAFT)
  reviewReason        String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner              User                @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents          StoreDocument[]
  products           StoreProduct[]
  orders             Order[]
  auditLogs          StoreAuditLog[]
  inventoryDocuments InventoryDocument[]

  @@index([ownerId, status, deletedAt])
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreDocument {
  id               String            @id @default(cuid())
  storeId          String
  type             StoreDocumentType
  name             String
  storageKey       String            @unique
  mimeType         String
  fileSize         Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, deletedAt])
  @@map("store_documents")
}

model StoreProduct {
  id                 String              @id @default(cuid())
  storeId            String
  type               StoreProductType
  name               String
  brand              String?
  manufacturer       String?
  origin             String?
  description        String?
  usagePurpose       String?
  usageInstructions  String?
  packaging          String?
  price              Decimal             @db.Decimal(14, 2)
  salePrice          Decimal?            @db.Decimal(14, 2)
  stock              Int                 @default(0)
  unit               String
  imageUrls          String[]            @default([])
  composition        String?
  phiDays            Int?
  safetyWarnings     String?
  status             StoreProductStatus  @default(DRAFT)
  reviewReason       String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([storeId, status, deletedAt])
  @@index([type, status, deletedAt])
  @@map("store_products")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  actorId     String?
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reference   String?
  note        String?
  createdAt   DateTime              @default(now())
  documentId  String

  product  StoreProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  document InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([documentId])
  @@map("inventory_movements")
}

model InventoryDocument {
  id           String                @id @default(cuid())
  storeId      String
  code         String                @unique
  type         InventoryDocumentType
  businessType InventoryBusinessType
  supplierName String?
  reason       String?
  note         String?
  orderId      String?
  actorId      String?
  actorName    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([type, businessType, createdAt])
  @@map("inventory_documents")
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  productId String
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id                 String               @id @default(cuid())
  orderCode          String               @unique
  farmerId           String
  storeId            String
  status             OrderStatus          @default(PENDING)
  recipientName      String
  recipientPhone     String
  shippingAddress    String
  note               String?
  paymentMethod      String               @default("COD")
  subtotal           Decimal              @db.Decimal(14, 2)
  shippingFee        Decimal              @default(20000) @db.Decimal(14, 2)
  rejectionReason    String?
  cancelledAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  farmer             User                 @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  histories          OrderStatusHistory[]
  inventoryDocuments InventoryDocument[]

  @@index([farmerId, status, deletedAt])
  @@index([storeId, status, deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String        @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  unitPrice    Decimal       @db.Decimal(14, 2)
  quantity     Int
  unit         String
  storeName    String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  actorId    String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model StoreAuditLog {
  id         String       @id @default(cuid())
  storeId    String
  actorId    String?
  action     String
  fromStatus StoreStatus?
  toStatus   StoreStatus?
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor      User?        @relation("StoreAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("store_audit_logs")
}

model ApprovalHistory {
  id         String         @id @default(cuid())
  subjectId  String
  actorId    String
  action     String
  fromStatus AccountStatus?
  toStatus   AccountStatus?
  reason     String?
  details    Json?
  createdAt  DateTime       @default(now())

  subject User @relation("ApprovalSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  actor   User @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_histories")
}

model AreaManagerApplication {
  id                    String   @id @default(cuid())
  userId                String   @unique
  identityNumber        String   @unique
  identityIssuedDate    DateTime
  identityIssuedPlace   String
  identityFrontKey      String
  identityBackKey       String
  organizationName      String
  taxCode               String?
  position              String
  officeProvince        String
  officeDistrict        String
  officeWard            String
  officeDetailedAddress String
  authorityDocumentKey  String
  managedRegions        Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationName])
  @@map("area_manager_applications")
}

model Document {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String?
  category    String
  status      DocumentStatus @default(DRAFT)
  fileName    String
  fileUrl     String
  storageKey  String         @unique
  mimeType    String
  fileSize    Int
  uploaderId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, publishedAt])
  @@index([category])
  @@map("documents")
}

model NewsArticle {
  id                String     @id @default(cuid())
  title             String
  description       String?
  imageUrl          String?
  sourceName        String
  originalUrl       String     @unique
  sourcePublishedAt DateTime?
  status            NewsStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Farm {
  id              String   @id @default(cuid())
  farmCode        String   @unique
  farmName        String
  areaSize        Float
  totalTrees      Int
  durianVariety   String
  address         String
  province        String?
  district        String?
  ward            String?
  areaUnit        String   @default("HECTARE")
  notes           String?
  latitude        Float?
  longitude       Float?
  growingRegion   String?
  growingRegionId String?
  isActive        Boolean  @default(true)
  isInSeason      Boolean  @default(true)
  farmerId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmer      User            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  region      GrowingRegion?  @relation(fields: [growingRegionId], references: [id], onDelete: SetNull)
  farmingLogs FarmingLog[]
  harvests    HarvestRecord[]

  @@index([farmerId])
  @@index([farmCode])
  @@index([growingRegionId])
}

model HarvestRecord {
  id                       String                 @id @default(cuid())
  code                     String                 @unique
  farmId                   String
  farmerId                 String
  buyerType                HarvestBuyerType       @default(UNDETERMINED)
  buyerFacilityId          String?
  buyerUserId              String?
  status                   HarvestStatus          @default(DRAFT)
  expectedHarvestDate      DateTime
  plotArea                 String?
  expectedTreeCount        Int?
  expectedFruitCount       Int?
  expectedWeight           Decimal                @db.Decimal(14, 2)
  weightUnit               String                 @default("kg")
  fruitCondition           String?
  evidenceImages           String[]               @default([])
  expectedSaleWeight       Decimal?               @db.Decimal(14, 2)
  expectedPricePerKg       Decimal?               @db.Decimal(14, 2)
  expectedBuyerArrivalDate DateTime?
  deliveryMethod           HarvestDeliveryMethod?
  transactionNote          String?
  rejectionReason          String?
  actualStartedAt          DateTime?
  actualHarvestedAt        DateTime?
  actualTreeCount          Int?
  actualFruitCount         Int?
  actualWeight             Decimal?               @db.Decimal(14, 2)
  actualImages             String[]               @default([])
  actualNote               String?
  farmerDeliveredAt        DateTime?
  buyerReceivedAt          DateTime?
  deliveredWeight          Decimal?               @db.Decimal(14, 2)
  receivedWeight           Decimal?               @db.Decimal(14, 2)
  weightDifferenceReason   String?
  completedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  farm                     Farm                   @relation(fields: [farmId], references: [id], onDelete: Restrict)
  farmer                   User                   @relation("HarvestFarmer", fields: [farmerId], references: [id], onDelete: Restrict)
  buyerFacility            PartnerFacility?       @relation(fields: [buyerFacilityId], references: [id], onDelete: SetNull)
  buyerUser                User?                  @relation("HarvestBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  histories                HarvestStatusHistory[]
  farmingLog               FarmingLog?

  @@index([farmerId, status, createdAt])
  @@index([buyerUserId, status, createdAt])
  @@index([farmId, expectedHarvestDate])
  @@map("harvest_records")
}

model HarvestStatusHistory {
  id         String         @id @default(cuid())
  harvestId  String
  actorId    String
  fromStatus HarvestStatus?
  toStatus   HarvestStatus
  note       String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  harvest    HarvestRecord  @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([harvestId, createdAt])
  @@map("harvest_status_histories")
}

model GrowingRegion {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  province      String
  district      String?
  ward          String?
  cropVarieties String[]  @default([])
  isActive      Boolean   @default(true)
  approvedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farms Farm[]

  @@index([province, district, ward, isActive])
  @@map("growing_regions")
}

model FarmingLog {
  id              String       @id @default(cuid())
  farmId          String
  stage           GrowthStage
  actionDate      DateTime
  activityType    ActivityType
  otherActivity   String?
  chemicalName    String?
  dosage          String?
  phiDays         Int?
  isGACCCompliant Boolean      @default(true)
  notes           String?
  images          String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  harvestRecordId String?      @unique

  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  harvestRecord HarvestRecord? @relation(fields: [harvestRecordId], references: [id], onDelete: SetNull)

  @@index([farmId, actionDate])
  @@index([stage])
  @@index([activityType])
}

model ProhibitedChemical {
  id        String   @id @default(cuid())
  name      String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}
