generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hệ thống vai trò người dùng.
enum UserRole {
  ADMIN
  AREA_MANAGER
  FARMER
  STORE_OWNER
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  NEED_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

enum StoreDocumentType {
  BUSINESS_REGISTRATION
  PESTICIDE_TRADING_LICENSE
  SPECIALIZED_DOCUMENT
}

enum StoreProductType {
  FERTILIZER
  PESTICIDE
}

enum StoreProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

/// Trạng thái duyệt tài khoản sau onboarding.
enum AccountStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
}

/// Giai đoạn sinh trưởng của cây sầu riêng.
enum GrowthStage {
  MAKING_SPROUT
  FLOWERING
  FRUIT_SETTING
  FRUIT_GROWING
  HARVEST
}

/// Loại hoạt động trong nhật ký canh tác.
enum ActivityType {
  SPRAY_PESTICIDE
  FERTILIZE
  IRRIGATE
  PRUNE
  WEEDING
}

/// Trạng thái tuân thủ GACC cho thuốc bảo vệ thực vật.
enum GaccChemicalStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
  UNKNOWN
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// Danh mục Giống sầu riêng (Master Data)
model DurianVariety {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String    @unique
  scientificName     String?
  description        String?
  origin             String?
  averageHarvestDays Int?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@map("durian_varieties")
}

/// Danh mục Thuốc bảo vệ thực vật (Master Data)
model Pesticide {
  id                  String             @id @default(cuid())
  code                String             @unique
  pesticideName       String?
  tradeName           String
  activeIngredient    String
  concentration       String?
  category            String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]           @default([])
  registrationNumber  String?
  gaccStatus          GaccChemicalStatus @default(UNKNOWN)
  localStatus         String?
  usagePurpose        String?
  targetPests         String?
  usageInstructions   String?
  recommendedDosage   String?
  safetyWarnings      String?
  storageInstructions String?
  phiDays             Int?
  notes               String?
  sourceReference     String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@map("pesticides")
}

/// Danh mục Phân bón (Master Data)
model Fertilizer {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  fertilizerType      String?
  brand               String?
  manufacturer        String?
  origin              String?
  imageUrls           String[]  @default([])
  nutrientComposition String?
  mainUses            String?
  targetCrops         String?
  usageInstructions   String?
  recommendedDosage   String?
  applicationMethod   String?
  safetyWarnings      String?
  storageInstructions String?
  sourceReference     String?
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@map("fertilizers")
}

model User {
  id                      String        @id @default(cuid())
  phone                   String        @unique
  email                   String?       @unique
  password                String
  fullName                String?
  avatar                  String?
  address                 String?
  province                String?
  district                String?
  ward                    String?
  registrationName        String?
  registeredAreaSize      Float?
  registeredTotalTrees    Int?
  registeredDurianVariety String?
  role                    UserRole
  isApproved              Boolean       @default(false)
  failedAttempts          Int           @default(0)
  lockUntil               DateTime?
  isLocked                Boolean       @default(false)
  accountStatus           AccountStatus @default(PENDING)
  approvedAt              DateTime?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  farms                  Farm[]
  notifications          Notification[]
  uploadedDocuments      Document[]
  areaManagerApplication AreaManagerApplication?
  approvalHistories      ApprovalHistory[]       @relation("ApprovalSubject")
  approvalActions        ApprovalHistory[]       @relation("ApprovalActor")
  stores                 Store[]                 @relation("StoreOwner")
  storeReviewActions     StoreAuditLog[]         @relation("StoreAuditActor")
  cartItems              CartItem[]
  orders                 Order[]                 @relation("FarmerOrders")

  @@index([role])
  @@index([role, accountStatus, deletedAt])
}

model Store {
  id                  String      @id @default(cuid())
  ownerId             String
  representativeName  String
  representativePhone String
  representativeEmail String?
  identityNumber      String
  name                String
  taxOrBusinessCode   String?
  address             String
  latitude            Float?
  longitude           Float?
  phone               String
  openingHours        String?
  signboardImageKey   String?
  description         String?
  status              StoreStatus @default(DRAFT)
  reviewReason        String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner     User            @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents StoreDocument[]
  products  StoreProduct[]
  orders    Order[]
  auditLogs StoreAuditLog[]

  @@index([ownerId, status, deletedAt])
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreDocument {
  id               String            @id @default(cuid())
  storeId          String
  type             StoreDocumentType
  name             String
  storageKey       String            @unique
  mimeType         String
  fileSize         Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuingAuthority String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, deletedAt])
  @@map("store_documents")
}

model StoreProduct {
  id                String             @id @default(cuid())
  storeId           String
  type              StoreProductType
  name              String
  brand             String?
  manufacturer      String?
  origin            String?
  description       String?
  usagePurpose      String?
  usageInstructions String?
  packaging         String?
  price             Decimal            @db.Decimal(14, 2)
  salePrice         Decimal?           @db.Decimal(14, 2)
  stock             Int                @default(0)
  unit              String
  imageUrls         String[]           @default([])
  composition       String?
  phiDays           Int?
  safetyWarnings    String?
  status            StoreProductStatus @default(DRAFT)
  reviewReason      String?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([storeId, status, deletedAt])
  @@index([type, status, deletedAt])
  @@map("store_products")
}

model CartItem {
  id        String       @id @default(cuid())
  userId    String
  productId String
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id              String               @id @default(cuid())
  orderCode       String               @unique
  farmerId        String
  storeId         String
  status          OrderStatus          @default(PENDING)
  recipientName   String
  recipientPhone  String
  shippingAddress String
  note            String?
  paymentMethod   String               @default("COD")
  subtotal        Decimal              @db.Decimal(14, 2)
  rejectionReason String?
  cancelledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  farmer          User                 @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  histories       OrderStatusHistory[]

  @@index([farmerId, status, deletedAt])
  @@index([storeId, status, deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String        @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  unitPrice    Decimal       @db.Decimal(14, 2)
  quantity     Int
  unit         String
  storeName    String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  actorId    String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model StoreAuditLog {
  id         String       @id @default(cuid())
  storeId    String
  actorId    String?
  action     String
  fromStatus StoreStatus?
  toStatus   StoreStatus?
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor      User?        @relation("StoreAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("store_audit_logs")
}

model ApprovalHistory {
  id         String         @id @default(cuid())
  subjectId  String
  actorId    String
  action     String
  fromStatus AccountStatus?
  toStatus   AccountStatus?
  reason     String?
  details    Json?
  createdAt  DateTime       @default(now())

  subject User @relation("ApprovalSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  actor   User @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_histories")
}

model AreaManagerApplication {
  id                    String   @id @default(cuid())
  userId                String   @unique
  identityNumber        String   @unique
  identityIssuedDate    DateTime
  identityIssuedPlace   String
  identityFrontKey      String
  identityBackKey       String
  organizationName      String
  taxCode               String?
  position              String
  officeProvince        String
  officeDistrict        String
  officeWard            String
  officeDetailedAddress String
  authorityDocumentKey  String
  managedRegions        Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationName])
  @@map("area_manager_applications")
}

model Document {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String?
  category    String
  status      DocumentStatus @default(DRAFT)
  fileName    String
  fileUrl     String
  storageKey  String         @unique
  mimeType    String
  fileSize    Int
  uploaderId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, publishedAt])
  @@index([category])
  @@map("documents")
}

model NewsArticle {
  id                String     @id @default(cuid())
  title             String
  description       String?
  imageUrl          String?
  sourceName        String
  originalUrl       String     @unique
  sourcePublishedAt DateTime?
  status            NewsStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Farm {
  id              String   @id @default(cuid())
  farmCode        String   @unique
  farmName        String
  areaSize        Float
  totalTrees      Int
  durianVariety   String
  address         String
  province        String?
  district        String?
  ward            String?
  areaUnit        String   @default("HECTARE")
  notes           String?
  latitude        Float?
  longitude       Float?
  growingRegion   String?
  growingRegionId String?
  isActive        Boolean  @default(true)
  isInSeason      Boolean  @default(true)
  farmerId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmer      User           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  region      GrowingRegion? @relation(fields: [growingRegionId], references: [id], onDelete: SetNull)
  farmingLogs FarmingLog[]

  @@index([farmerId])
  @@index([farmCode])
  @@index([growingRegionId])
}

model GrowingRegion {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  province      String
  district      String?
  ward          String?
  cropVarieties String[]  @default([])
  isActive      Boolean   @default(true)
  approvedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farms Farm[]

  @@index([province, district, ward, isActive])
  @@map("growing_regions")
}

model FarmingLog {
  id              String       @id @default(cuid())
  farmId          String
  stage           GrowthStage
  actionDate      DateTime
  activityType    ActivityType
  chemicalName    String?
  dosage          String?
  phiDays         Int?
  isGACCCompliant Boolean      @default(true)
  notes           String?
  images          String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, actionDate])
  @@index([stage])
  @@index([activityType])
}

model ProhibitedChemical {
  id        String   @id @default(cuid())
  name      String   @unique
  reason    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}
